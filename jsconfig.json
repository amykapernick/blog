{
	"compilerOptions": {
		"baseUrl": ".",
		"paths": {
			"@partials/*": [
				"src/partials/*.astro"
			],
			"@parts/*": [
				"src/parts/*.astro"
			],
			"@img/*": [
				"src/img/*",
				"src/img/*.astro"
			],
			"@pages/*": [
				"src/pages/*.astro"
			],
			"@styles/*": [
				"src/scss/*"
			],
			"@utils/*": [
				"src/utils/*"
			],
			"@layouts/*": [
				"src/layouts/*.astro"
			],
			"@data/*": [
				"_data/*"
			]
		},
		"jsx": "react-jsx",
		"jsxImportSource": "react"
	}
}