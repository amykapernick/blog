---
import { parseISO, format } from "date-fns";
import Layout from "@layouts/base";
import SVG from "@parts/svg";
import Video from "@parts/video";
import slugify from "@utils/slugify";
import generateSocialImages from '@utils/generateSocialImages'


const { title, categories, video, featured, date = new Date().toISOString(), updated } = Astro.props.content;

const socialImages = featured?.src ? await generateSocialImages(featured.src) : {}

const content = {
	...Astro.props.content,
	title: `${title} | Amy's Blog`,
	...socialImages
};

---

<Layout content={content}>
	<article class="content" id="main">
		<header>
			<h1>{title}</h1>
			{updated &&
				<span>
					Updated on: 
					<time datetime={format(parseISO(updated), "yyyy-mm-dd")}>
						{format(parseISO(updated), "dd MMM yyyy")}
					</time>
				</span>
			}
			<span>
				{updated && "Published on: "}
				<time datetime={format(parseISO(date), "yyyy-mm-dd")}>
					{format(parseISO(date), "dd MMM yyyy")}
				</time>
			</span>
			{
				categories && (
					<ul class="tags">
						{categories.map((tag) => (
							<li>
								<a href={`/tags/${slugify(tag)}/1`}>
									#{slugify(tag)}
								</a>
							</li>
						))}
					</ul>
				)
			}
			<div class="underline">
				<SVG name="illustrations/underline.svg" />
			</div>
		</header>
		
		<slot />
		{video && <Video video={video} title={title} />}
	</article>
</Layout>
