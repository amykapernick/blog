---
import Layout from "../../../layouts/feed.astro";
import { isBefore, parseISO } from "date-fns";
import slugify from "../../../utils/slugify";
import getAllPosts from "../../../utils/getAllPosts";
import generatePageData from "../../../utils/generatePageData";

export async function getStaticPaths({ paginate }) {
	const postFiles = await Astro.glob("../../../../posts/**/*.md");
	const videoFiles = await Astro.glob("../../../../videos/**/*.md");

	const { allPosts, allTags } = await getAllPosts({
		files: {
			post: postFiles,
			video: videoFiles,
		},
	})

	return allTags.map((tag) => {
		const filteredPosts = allPosts.filter(({ post }) =>
			post?.frontmatter?.categories?.includes(tag)
		);
		return paginate(filteredPosts, {
			params: { tag: slugify(tag) },
			pageSize: 12,
		});
	});
}

const { tag } = Astro.params;

const content = {
	title: `#${tag} posts | Amy's Blog`,
	class: "home",
};

const data = {
	...generatePageData({page: Astro.props.page}),
	content,
};
---

<Layout data={data}>
	<h1 class="tag-page">Filtered by: #{tag}</h1>
</Layout>
