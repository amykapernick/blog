---
import Layout from "../../../layouts/feed.astro";
import { isBefore, parseISO } from "date-fns";
import slugify from "../../../utils/slugify";
import getAllPosts from "../../../utils/getAllPosts";
import generatePageData from "../../../utils/generatePageData";

export async function getStaticPaths({ paginate }) {
	const postFiles = Object.values(import.meta.glob("../../../../posts/**/*.md", { eager: true }));
	const videoFiles = Object.values(import.meta.glob("../../../../videos/**/*.md", { eager: true }));

	const { allPosts, allTags } = await getAllPosts({
		files: {
			post: postFiles,
			video: videoFiles,
		},
	})

	const allPages: any = []

	allTags.forEach((tag) => {
		allPages.push(
			...paginate(
				allPosts.filter(({ post }) =>
					post?.frontmatter?.categories?.includes(tag)
				), 
				{
					params: { tag: slugify(tag) },
					pageSize: 12,
				}
			)
		) 
	});	

	return allPages
}

const { tag } = Astro.params;

const content = {
	title: `#${tag} posts | Amy's Blog`,
	class: "home",
};

const data = {
	...generatePageData({page: Astro.props.page}),
	content,
};

---

<Layout data={data}>
	<h1 class="tag-page">Filtered by: #{tag}</h1>
</Layout>
