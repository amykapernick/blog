---
import Layout from "../layouts/post.astro";
import TableOfContents from '../parts/toc.astro'
import getAllPosts from "../utils/getAllPosts";

export async function getStaticPaths() {
	const postFiles = Object.values(import.meta.glob("../../posts/**/*.md", { eager: true }));
	const videoFiles = Object.values(import.meta.glob("../../videos/**/*.md", { eager: true }));

	const { allPosts } = await getAllPosts({
		files: {
			post: postFiles,
			video: videoFiles,
		},
	})

	return allPosts.map(({post}) => ({
		params: {
			slug: post.slug
		},
		props: {
			...post
		}
	}));
}

const { slug } = Astro.params;
const { frontmatter, getHeadings, Content } = Astro.props;

const postContent = {
	...frontmatter,
	slug,
};

const headings = getHeadings()

---

<Layout content={postContent}>
	{frontmatter?.toc && <TableOfContents {headings} />}
	<Content />
</Layout>
