---
import { Picture, Image } from 'astro:assets';

const { featured } = Astro.props

const image = featured?.src
	? `/img/${featured.src}`
	: "/img/feature/placeholder.png";

---

<style>
	.image {
		position: relative;

		& > img {
			z-index: -1;
			position: absolute;
			min-width: 100%;
			min-height: 100%;
			object-fit: cover;
			filter: blur(1em);
		}

		& > picture {
			z-index: 2;
			& img {
				width: 100%;
				height: 100%;
				object-fit: contain;
				object-position: center;
			}
		}
	}
</style>

<div class="image">
	<Image
		src={image}
		alt=""
		widths={[40]}
		width={40}
		height={30}
	/>
	<Picture
		src={image}
		alt=""
		formats={["avif", "webp", "jpg", "png"]}
		widths={[300, 600, 800]}
		aspectRatio="3:4"
		width={800}
		height={600}
	/>
</div>